# =============================================================================
# Instagram (required - first 3 vars)
# =============================================================================
IG_WEBHOOK=           # Discord webhook URL
IG_ROLE=              # Discord role ID to ping (e.g. 1488594717842342053)
IG_TARGET=            # Instagram username to watch (e.g. nmixx_official)

IG_USERNAME=          # Instagram login username (optional, but needed for fetching)
IG_PASSWORD=          # Instagram login password (optional)
IG_PROXY=             # Proxy for Instagram (optional, e.g. http://user:pass@host:port)
IG_POLL_INTERVAL=300  # Polling interval in seconds (min: 10, default: 600)
IG_THREAD_ID=         # Discord thread ID to post in (optional)

# =============================================================================
# JYP Fans (optional - run login.py first to create a session)
# =============================================================================
FANS_WEBHOOK=         # Discord webhook URL
FANS_ROLE=            # Discord role ID to ping
FANS_TARGET=          # Group code to watch (e.g. nmixx, twice, itzy...)
FANS_POLL_INTERVAL=600 # Polling interval in seconds (min: 10, default: 300)
FANS_THREAD_ID=       # Discord thread ID (optional)

# =============================================================================
# YouTube Push (optional - requires NGROK_TOKEN)
# =============================================================================
YT_WEBHOOK=           # Discord webhook URL
YT_ROLE=              # Discord role ID to ping
YT_TARGETS=           # YouTube channel ID(s), comma-separated (e.g. UC...,UC...)
YT_THREAD_ID=         # Discord thread ID (optional)
NGROK_TOKEN=          # Token from https://dashboard.ngrok.com/get-started/your-authtoken

# =============================================================================
# X / Twitter (optional - requires TWITTER_AUTH_TOKEN)
# =============================================================================
TWITTER_WEBHOOK=      # Discord webhook URL
TWITTER_ROLE=         # Discord role ID to ping
TWITTER_TARGETS=      # Twitter username(s), comma-separated (e.g. WE_NMIXX,NMIXX_official)
TWITTER_POLL_INTERVAL=600 # Polling interval in seconds (min: 10, default: 300)
TWITTER_THREAD_ID=    # Discord thread ID (optional)
# Get auth_token from Twitter browser cookie after login (auth_token=...)
TWITTER_AUTH_TOKEN=

# =============================================================================
# Gemini Translation (optional)
# =============================================================================
GEMINI_API_KEY=       # Google Gemini API key for Korean → Vietnamese translation

# =============================================================================
# Error Alert (optional)
# =============================================================================
ERROR_WEBHOOK=        # Discord webhook for critical error alerts
