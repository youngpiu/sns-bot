# Instagram (bắt buộc)
IG_WEBHOOK=
IG_ROLE=
IG_TARGET=
IG_SESSIONID=
IG_POLL_INTERVAL=600
IG_THREAD_ID=

# Fans (optional)
FANS_WEBHOOK=
FANS_ROLE=
FANS_TARGET=
FANS_POLL_INTERVAL=300
FANS_THREAD_ID=

# YouTube push (optional, cần NGROK_TOKEN)
YT_WEBHOOK=
YT_ROLE=
YT_TARGETS=UC...
YT_THREAD_ID=

# Twitter (optional, cần TWITTER_AUTH_TOKEN)
TWITTER_WEBHOOK=
TWITTER_ROLE=
TWITTER_TARGET=
TWITTER_POLL_INTERVAL=300
TWITTER_THREAD_ID=
# Lấy auth_token từ cookie Twitter (auth_token=...)
TWITTER_AUTH_TOKEN=

# Gemini (dịch thuật, optional)
GEMINI_API_KEY=

# Error webhook (optional) — gửi alert khi task bị lỗi nặng
ERROR_WEBHOOK=

# Ngrok (bắt buộc cho YouTube push)
# Đăng ký tại https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_TOKEN=
